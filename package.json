{
  "name": "ssui",
  "private": true,
  "author": "西风逍遥游 <sunxfancy@gmail.com>",
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "desktop",
    "frontend/ssui_components",
    "frontend/functional_ui",
    "ssui-vscode",
    "extension_builder",
    "extensions/Image",
    "extensions/example",
    "packages/canvas-engine"
  ],
  "scripts": {
    "dev:desktop_sb": "yarn storybook",
    "dev:desktop": "yarn build:frontend && node dependencies/dev_run.cjs workspace ssui-desktop tauri dev",
    "dev:server": "yarn build:frontend && node dependencies/venv.cjs python -m server --dev",
    "dev:server:no_build": "node dependencies/venv.cjs python -m server --dev",
    "dev:executor": "node dependencies/venv.cjs python -m ss_executor",
    "dev:functional_ui": "yarn workspace ssui-functional_ui dev",
    "dev:canvas": "yarn workspace ssui-image dev",
    "dev:vscode": "yarn workspace ssui-vscode watch",
    "build:frontend": "yarn build:components && yarn build:functional_ui && yarn build:canvas",
    "build:desktop_ui": "yarn workspace ssui-desktop build",
    "build:desktop": "yarn workspace ssui-desktop tauri build",
    "build:desktop:debug": "yarn workspace ssui-desktop tauri build --debug",
    "build:components": "yarn workspace ssui_components build",
    "build:canvas": "yarn workspace ssui-image build",
    "build:canvas-engine": "yarn workspace @ssui/canvas-engine build",
    "test:canvas-engine": "yarn workspace @ssui/canvas-engine test",
    "build:functional_ui": "yarn workspace ssui-functional_ui build",
    "build:example": "yarn workspace ssui-example-plugin build",
    "build:extension_builder": "yarn workspace extension_builder build",
    "build:vscode": "yarn workspace ssui-vscode compile",
    "ext:package": "concurrently \"yarn ext:package_Image\" \"yarn ext:package_Video\" \"yarn ext:package_Audio\"",
    "ext:package_Image": "cd extensions/Image && ssext package -o ../../desktop/src-tauri/resources/extensions/",
    "ext:package_Video": "cd extensions/Video && ssext package -o ../../desktop/src-tauri/resources/extensions/",
    "ext:package_Audio": "cd extensions/Audio && ssext package -o ../../desktop/src-tauri/resources/extensions/",
    "test": "node dependencies/venv.cjs python tests/run_tests.py",
    "test_on": "node dependencies/venv.cjs python tests/run_tests.py --test",
    "package": "yarn build:frontend && yarn build:extension_builder && yarn ext:package && yarn build:desktop",
    "package:debug": "yarn build:frontend && yarn ext:package && yarn build:desktop:debug",
    "package:vscode": "cd ssui-vscode && yarn package",
    "dev:paths": "node dependencies/dev_config.cjs",
    "test:dev-config": "node --test dependencies/dev_config.test.cjs",
    "test:runtime-target": "node --test dependencies/runtime_target.test.cjs",
    "test:dependency-config": "node --test dependencies/dependency_config.test.cjs",
    "test:wheel-audit": "node dependencies/venv.cjs python -m unittest discover -s dependencies -p audit_wheels_test.py",
    "audit:wheels": "node dependencies/venv.cjs python dependencies/audit_wheels.py",
    "check_deps": "yarn --version && rustc --version && cargo --version",
    "requirements": "node dependencies/combine_requirements.cjs",
    "requirements:generate": "node dependencies/generate_requirements.cjs",
    "requirements:check": "node dependencies/generate_requirements.cjs --check",
    "install-requirements": "node dependencies/install_requirements.cjs",
    "update-lock": "node dependencies/update_lock.cjs",
    "update-lock:all": "node dependencies/update_lock.cjs --all",
    "update-lock:no-upgrade": "node dependencies/update_lock.cjs --no-upgrade",
    "pack-offline": "node dependencies/pack_offline.cjs",
    "pack-offline:all": "node dependencies/pack_offline.cjs --all",
    "test:components": "yarn workspace ssui_components jest test/ComponentsManager.test.ts",
    "postinstall": "node dependencies/install.cjs",
    "docker": "docker build -t ssui-docker .",
    "docker-run": "docker run -it --gpus all -p 7422:7422 ssui-docker",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:storybook": "node --test .storybook/mocks/api.test.mjs",
    "probe:arm64": "node dependencies/venv.cjs python dependencies/probe_arm64.py",
    "test:native-tools": "node dependencies/venv.cjs python -m unittest discover -s tests -p native_tools_test.py",
    "test:arm64-workflows": "node dependencies/venv.cjs python tests/arm64_cpu_workflows.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "extension_builder": "*",
    "js-yaml": "^4.1.0",
    "semver": "^7.5.4",
    "@storybook/addon-essentials": "^8.6.10",
    "@storybook/builder-vite": "^8.6.10",
    "@storybook/react-vite": "^8.6.10",
    "storybook": "^8.6.10",
    "vite": "^6.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}

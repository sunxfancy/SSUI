 namespace cumesh {
 
+// Windows HIP's narrow-pitch 2D copies silently truncate above 2^20 rows.
+// Bound each copy; do not rely on a successful return code for a tall copy.
+static cudaError_t copy_tensor_rows(
+    void* dst, size_t dst_pitch, const void* src, size_t src_pitch,
+    size_t width, size_t height, cudaMemcpyKind kind) {
+    constexpr size_t chunk_rows = 65536;
+    for (size_t row = 0; row < height; row += chunk_rows) {
+        auto status = cudaMemcpy2D(
+            static_cast<char*>(dst) + row * dst_pitch, dst_pitch,
+            static_cast<const char*>(src) + row * src_pitch, src_pitch,
+            width, std::min(chunk_rows, height - row), kind);
+        if (status != cudaSuccess) return status;
+    }
+    return cudaSuccess;
+}
+
 
